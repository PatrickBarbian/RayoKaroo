<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/accent_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/extension_description"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 1. RAYO BLUETOOTH SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_rayo"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvPairedStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_paired"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnScanPair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/accent_red"
                android:text="@string/btn_scan_pair"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/default_profile_title"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spnDefaultProfile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp" />

            <Button
                android:id="@+id/btnTestToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#333333"
                android:text="@string/test_connection"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 2. RADAR THREAT REACTION SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_radar"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/swRadarThreat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/radar_threat_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/radar_threat_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Rayo Profile on Radar Threat -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Rayo-Profil bei Fahrzeug-Warnung"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spnRadarRayoProfile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp" />

            <!-- Radar Hold Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/radar_hold_title"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spnRadarHoldSec"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp" />

            <!-- Radar Simulator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="#282A33" />

            <Switch
                android:id="@+id/swRadarSim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/radar_sim_title"
                android:textColor="#FFAA00"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/radar_sim_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. G-FORCE BRAKE LIGHT SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_brake"
            android:textColor="#FF2A55"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/swBrakeEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/brake_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/brake_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Sensitivity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/brake_sensitivity_title"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spnBrakeSensitivity"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp" />

            <!-- Brake Hold Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/brake_hold_title"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spnBrakeHoldSec"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 5. SPEED-ADAPTIVE LIGHTING SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_speed"
            android:textColor="#9C27B0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/swSpeedAdaptive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/speed_adaptive_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/speed_adaptive_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Speed Threshold -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/speed_threshold_title"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spnSpeedThreshold"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 6. RIDE AUTOMATION & PAUSE SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_automation"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/swAutoStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/auto_start_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/auto_start_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Pause Behavior -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pause_behavior_title"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spnPauseBehavior"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp" />

            <!-- In-Ride Alerts -->
            <Switch
                android:id="@+id/swInRideAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:checked="true"
                android:text="@string/in_ride_alerts_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/in_ride_alerts_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status log output -->
        <TextView
            android:id="@+id/tvSettingsLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:fontFamily="monospace"
            android:textColor="@color/accent_green"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
